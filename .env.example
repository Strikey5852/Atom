# Discord Bot Token (required)
TOKEN=your_discord_bot_token_here

# GitHub Token with gist scope (required)
# Create a personal access token at: https://github.com/settings/tokens
# Make sure to select the "gist" scope
GITHUB_TOKEN=your_github_token_here

# GitHub Gist ID (optional - will be auto-created if not set)
# If you want to use an existing gist, put its ID here
# Otherwise, leave it blank or set GIST_AUTO_CREATE=true
GIST_ID=

# Auto-create gist if it doesn't exist (default: true)
GIST_AUTO_CREATE=true

# ──────────────────────────────────────────────
# Logging Configuration (optional)
# ──────────────────────────────────────────────
# Default log level for ALL cogs (DEBUG/INFO/WARNING/ERROR)
# Default: INFO
COG_LOG_LEVEL=INFO
COG_LOG_LEVEL_QOTD=DEBUG

# Per-cog overrides — set to DEBUG for verbose, WARNING/ERROR for quiet
# Available cogs: CATS, DICE, GIFS, QOTD, STICKY, TRAP
# Examples:
# COG_LOG_LEVEL_GIFS=DEBUG
# COG_LOG_LEVEL_TRAP=WARNING
# COG_LOG_LEVEL_QOTD=ERROR
