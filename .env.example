# Discord bot token (required)
TOKEN=your_discord_bot_token_here

# GitHub personal access token with gist scope (required)
# Generate it here: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Optional: use an existing private gist ID.
# If left blank, the bot will create one automatically when it starts.
GIST_ID=

# Auto-create a gist if one is not already configured.
GIST_AUTO_CREATE=true

# Optional local health-check port for the bot's HTTP listener.
PORT=8000

# Optional logging config.
# Default level for all cogs unless overridden below.
COG_LOG_LEVEL=INFO

# Per-cog overrides. Set to DEBUG for verbose logs or WARNING/ERROR to reduce noise.
# Available cogs: CATS, DICE, GIFS, QOTD, STICKY, TRAP
# Example overrides:
# COG_LOG_LEVEL_GIFS=DEBUG
# COG_LOG_LEVEL_TRAP=WARNING
# COG_LOG_LEVEL_QOTD=ERROR
